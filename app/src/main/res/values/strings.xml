    <!-- About -->
    <string name="about_title">About and sources</string>
    <string name="about_hint">Data sources, licences, privacy</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_disclaimer_title">Unofficial app</string>
    <string name="about_disclaimer">This app is not affiliated with the Israeli Ministry of Transport. It helps you prepare for the theory test using the official question pool. Check gov.il for the current exam rules.</string>
    <string name="about_questions_title">Questions</string>
    <string name="about_questions">The official theory test question and answer pool (in English and Russian), published by the Israeli Ministry of Transport and Road Safety on the open data portal data.gov.il. Illustrations are from gov.il. The official pool has no written explanations, so the review shows the chosen and the correct answers.</string>
    <string name="about_signs_title">Road signs</string>
    <string name="about_signs">Numbers, categories and meanings follow the official Israeli road sign table (translations made for this app). Sign images are from Wikimedia Commons: some are in the public domain, others are licensed under CC BY-SA 3.0 and 4.0; the author and licence of every image are listed under “Image credits”. Road marking pictures are from the official question pool.</string>
    <string name="credits_title">Image credits</string>
    <string name="credits_intro">The road sign images come from Wikimedia Commons. Each entry gives the title (linked to the file page), the author and the licence. The original SVG files were converted to 330-pixel-wide WebP images; modified versions of CC BY-SA images are shared under the same licence.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy">The app works fully offline and does not request internet access. Progress is stored on the device only and is moved manually by exporting and importing a file.</string>
